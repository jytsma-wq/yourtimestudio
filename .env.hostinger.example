# Current form submissions use Prisma + DATABASE_URL.
# No email provider, payment, CRM, or reCAPTCHA secret is required by the current code.
# Missing DATABASE_URL is handled gracefully by the API routes with a user-safe error.

# Optional public contact channels. Leave blank until the accounts exist.
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_WHATSAPP_HREF=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
