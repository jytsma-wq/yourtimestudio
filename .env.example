DATABASE_URL="file:./dev.db"
FORM_INBOX_READY="false"
NEXT_PUBLIC_SITE_URL="https://batumilighthouse.com"
NEXT_PUBLIC_CONTACT_EMAIL="hello@batumilighthouse.com"
NEXT_PUBLIC_ANALYTICS_DOMAIN="batumilighthouse.com"

# Form submissions use Prisma + DATABASE_URL, but remain fail-closed while
# FORM_INBOX_READY is false. Set it to true only after the owner has configured
# a notification, a protected inbox, or a reliable process that polls the database.
# Missing database configuration is handled with a user-safe fallback.

# Optional public contact channels. Leave blank until the accounts exist.
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_WHATSAPP_HREF=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
